{$BASE_HOST} {
    tls internal
    encode gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        -Server
    }
    request_body {
        max_size 21MB
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
}
